NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Batch 6 — service-role key, SERVER-SIDE ONLY. Never prefix with
# NEXT_PUBLIC_ and never import lib/supabase/admin.ts from a "use client"
# file. Used sparingly for trusted server code that must bypass RLS
# (e.g. audit log writes, future webhook handlers) — most admin reads
# go through the normal authenticated client per lib/data/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Batch 5 — Payments (Paystack). Leave unset to use the built-in demo
# payment flow (PaystackButton simulates a successful charge so the
# booking/order/membership flows stay fully clickable in preview).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# Batch 5 — AI chat backend (Anthropic). Leave unset and the widget
# falls back to a friendly "team will get back to you" message instead
# of a live model response.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
